{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project YI data model (MVP, 1597)",
  "description": "원본 달력 표기를 보존하고, 변환값·확실도·출처를 항상 함께 저장한다. 해석은 데이터가 아니라 note/claim으로 분리한다.",
  "$defs": {
    "DateRecord": {
      "type": "object",
      "required": ["original", "precision", "certainty"],
      "properties": {
        "original": {
          "type": "object",
          "required": ["calendar", "year"],
          "properties": {
            "calendar": {"enum": ["lunisolar", "gregorian", "julian"]},
            "year": {"type": "integer"},
            "month": {"type": ["integer", "null"]},
            "day": {"type": ["integer", "null"]},
            "leap_month": {"type": "boolean"}
          }
        },
        "gregorian": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
        "julian": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
        "computed_gregorian": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "변환기가 계산한 양력. 사료/입력값(gregorian)과 다르면 certainty=disputed 로 병기한다."},
        "converter": {"type": ["string", "null"]},
        "basis_entry_ids": {"type": ["array", "null"], "items": {"type": "string"}, "description": "이 날짜를 일간지로 확정한 일기 항목 id. 검증기가 해당 항목의 양력·일간지 확정 여부를 확인한다."},
        "ganji_check": {
          "type": ["object", "null"],
          "description": "일기에 적힌 일간지가 gregorian 날짜의 실제 일간지와 다를 때의 구조화 기록. 숨기지 않고 병기한다.",
          "required": ["written", "expected", "stem_match"],
          "properties": {
            "written": {"type": "string"},
            "expected": {"type": "string"},
            "stem_match": {"type": "boolean", "description": "천간만 일치하는가"},
            "branch_shift": {"type": ["integer", "null"], "description": "written 지지 - expected 지지 (mod 12, -5..6)"}
          }
        },
        "precision": {"enum": ["day", "month", "year", "range"]},
        "end_year": {"type": ["integer", "null"]},
        "certainty": {"enum": ["verified", "unverified", "disputed"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "Source": {
      "type": "object",
      "required": ["id", "title", "layer", "origin", "reliability", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^src-"},
        "title": {"type": "string"},
        "layer": {"enum": ["contemporary", "compiled_later", "modern_reception", "contemporary_scholarship", "popular", "reference_secondary", "unclassified"]},
        "origin": {"enum": ["kr", "jp", "cn", "west", "intl"]},
        "reliability": {"enum": ["A", "B", "C", "unrated"]},
        "status": {"enum": ["confirmed", "candidate_unverified"]},
        "citation": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "Event": {
      "type": "object",
      "required": ["id", "track", "title_ko", "date", "source_ids", "verified"],
      "properties": {
        "id": {"type": "string", "pattern": "^ev-"},
        "track": {"enum": ["yi", "world"]},
        "title_ko": {"type": "string"},
        "title_en": {"type": ["string", "null"]},
        "category": {"type": "string"},
        "date": {"$ref": "#/$defs/DateRecord"},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "verified": {"type": "boolean"},
        "note": {"type": ["string", "null"]}
      }
    },
    "Claim": {
      "type": "object",
      "required": ["id", "event_id", "field", "value", "source_ids", "status"],
      "description": "출처별로 갈리는 수치·서술. 하나로 합치지 않고 병기한다.",
      "properties": {
        "id": {"type": "string", "pattern": "^cl-"},
        "event_id": {"type": "string"},
        "field": {"type": "string"},
        "value": {"type": ["string", "number"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["unverified", "verified", "disputed"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "Edition": {
      "type": "object",
      "required": ["id", "title", "kind", "is_base"],
      "properties": {
        "id": {"type": "string", "pattern": "^ed-"},
        "title": {"type": "string"},
        "kind": {"enum": ["autograph", "copy", "printed", "transcription", "critical_edition"]},
        "year": {"type": ["integer", "null"]},
        "is_base": {"type": "boolean"},
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "note": {"type": ["string", "null"]}
      }
    },
    "Reading": {
      "type": "object",
      "required": ["id", "edition_id", "reader"],
      "description": "판독(탈초·교감) 단위. 같은 판본도 판독자에 따라 글자가 달라질 수 있다.",
      "properties": {
        "id": {"type": "string", "pattern": "^rd-"},
        "edition_id": {"type": "string"},
        "reader": {"type": "string"},
        "year": {"type": ["integer", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "DiaryEntry": {
      "type": "object",
      "required": ["id", "edition_id", "reading_id", "date", "text_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^de-"},
        "edition_id": {"type": "string"},
        "reading_id": {"type": "string"},
        "date": {"$ref": "#/$defs/DateRecord"},
        "volume": {"type": ["string", "null"], "description": "같은 판본 안의 책(예: 친필 초고의 5책 정유일기 / 6책 속정유일기). 같은 날짜가 여러 책에 있을 수 있다."},
        "day_ganji": {"type": ["string", "null"], "pattern": "^[甲乙丙丁戊己庚辛壬癸][子丑寅卯辰巳午未申酉戌亥]$", "description": "일기 날짜 머리의 일간지. 양력 날짜를 직접 식별하는 근거(역법 차이와 무관)."},
        "text_han": {"type": ["string", "null"], "description": "분석 대상은 한문 판독본."},
        "text_ko": {"type": ["string", "null"], "description": "표시용 번역. 분석에 쓰지 않는다."},
        "translator": {"type": ["string", "null"]},
        "source_ref": {"type": ["string", "null"], "description": "저본 위치(교감본 권·쪽 등). 재확인용."},
        "input_by": {"type": ["string", "null"]},
        "input_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "reviewed_by": {"type": ["string", "null"]},
        "text_status": {"enum": ["placeholder", "transcribed", "reviewed"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "ReadingIssue": {
      "type": "object",
      "description": "판독 쟁점 카드. 같은 글자를 두고 판독·해석이 갈리는 대목을 출현 위치(일기 항목)와 함께 기록한다. 모든 읽기·해석은 주장자와 출처를 붙인 '주장'으로만 담고, 이 프로젝트가 판정하지 않는다.",
      "required": ["id", "title_ko", "summary", "occurrences", "readings", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^ri-"},
        "title_ko": {"type": "string"},
        "summary": {"type": "string"},
        "occurrences": {
          "type": "array",
          "description": "쟁점 글자가 나오는 일기 항목. 검증기가 portal_reading 과 context 가 해당 항목 본문에 실제로 있는지 확인한다.",
          "items": {
            "type": "object",
            "required": ["entry_id", "portal_reading", "context"],
            "properties": {
              "entry_id": {"type": "string"},
              "portal_reading": {"type": "string"},
              "position": {"type": ["string", "null"]},
              "context": {"type": "string"}
            }
          }
        },
        "readings": {
          "type": "array",
          "description": "글자를 어떻게 읽는가(판독). observed=이 프로젝트가 가진 판독문에서 관찰, claim=특정인의 주장(source_ids 필수).",
          "items": {
            "type": "object",
            "required": ["id", "label", "proponent", "status", "source_ids"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "proponent": {"type": "string"},
              "per_entry": {"type": ["object", "null"], "description": "항목 id -> 그 항목에서의 읽기. 언급이 없는 항목은 적지 않는다."},
              "claim": {"type": ["string", "null"]},
              "basis": {"type": ["string", "null"]},
              "status": {"enum": ["observed", "claim"]},
              "source_ids": {"type": "array", "items": {"type": "string"}},
              "note": {"type": ["string", "null"]}
            }
          }
        },
        "interpretations": {
          "type": ["array", "null"],
          "description": "그 글자를 무슨 뜻으로 보는가(해석). 판독과 구분해 둔다.",
          "items": {
            "type": "object",
            "required": ["id", "label", "claim", "proponent", "status", "source_ids"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "claim": {"type": "string"},
              "proponent": {"type": "string"},
              "status": {"enum": ["claim", "reception"]},
              "source_ids": {"type": "array", "items": {"type": "string"}},
              "note": {"type": ["string", "null"]}
            }
          }
        },
        "history": {
          "type": ["array", "null"],
          "description": "판본·번역·보도에서 이 대목이 어떻게 다뤄져 왔는가(수용사).",
          "items": {
            "type": "object",
            "required": ["year", "event", "status", "source_ids"],
            "properties": {
              "year": {"type": "integer"},
              "event": {"type": "string"},
              "status": {"enum": ["claim", "unchecked"]},
              "source_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "observations": {
          "type": ["array", "null"],
          "description": "우리 데이터·점검에서 직접 확인한 사실.",
          "items": {
            "type": "object",
            "required": ["text", "kind"],
            "properties": {"text": {"type": "string"}, "kind": {"enum": ["data", "check"]}}
          }
        },
        "to_resolve": {"type": ["array", "null"], "items": {"type": "string"}},
        "status": {"enum": ["unresolved", "resolved"]},
        "caution": {"type": ["string", "null"]}
      }
    },
    "Coverage": {
      "type": "object",
      "required": ["id", "edition_id", "period", "status"],
      "description": "\"없음\"(사건 없음)과 \"기록 안 됨/결락\"을 구분하기 위한 결측 기록.",
      "properties": {
        "id": {"type": "string", "pattern": "^cv-"},
        "edition_id": {"type": "string"},
        "period": {"type": "string"},
        "status": {"enum": ["extant", "missing_in_edition", "not_written_or_unknown", "to_verify"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
